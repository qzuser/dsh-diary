{
  "name": "dsh-diary",
  "version": "1.0.0",
  "description": "每天定时让 agent 给自己写两篇日记（公开版 + 私密版）。时间、数据源、字数、文风、脱敏词、输出路径、文件名模板全部可配。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "diary",
    "journal"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "license": "MIT"
}
